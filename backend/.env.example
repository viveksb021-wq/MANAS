# MANAS Backend Environment Variables Template

# Database Connection (Supports SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./manas.db
# Example PostgreSQL URL: postgresql://postgres:password@localhost:5432/manas_db

# JWT Security
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Environment (development / production)
ENVIRONMENT=development

# Automatic Seeding (Set to 'false' in production)
AUTO_SEED=true
