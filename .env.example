# MANAS Full Stack Environment Variables Template

# Backend Settings
DATABASE_URL=sqlite:///./manas.db
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=development
AUTO_SEED=true

# Frontend Settings (Vite prefix VITE_)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ENABLE_DEMO_BAR=true
